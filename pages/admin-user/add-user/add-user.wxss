/* pages/admin-user/add-user/add-user.wxss */

/* 全局样式 */
page {
  margin: 0;
  padding: 0;
  font-family: 'Segoe UI', sans-serif;
  background-color: #f0f2f5;
  min-height: 100vh !important;
}

/* 主容器 */
.add-user-container {
  padding: 40rpx;
  box-sizing: border-box;
}

/* 页面标题 */
.page-header {
  margin-bottom: 40rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

/* 提示信息 */
.info-section {
  background-color: #e6f7ff;
  border: 2rpx solid #91d5ff;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-bottom: 40rpx;
}

.info-text {
  font-size: 28rpx;
  color: #1890ff;
  line-height: 1.5;
}

/* 表单区域 */
.form-section {
  background-color: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 40rpx;
}

/* 表单项 */
.form-item {
  margin-bottom: 30rpx;
}

/* 标签 */
.label {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 15rpx;
  display: block;
}

/* 输入框 */
.input {
  width: 100%;
  height: 80rpx;
  border: 4rpx solid rgba(105, 105, 105, 0.397);
  border-radius: 15rpx;
  padding: 0 20rpx;
  font-size: 32rpx;
  box-sizing: border-box;
  background-color: white;
}

/* 单选按钮组 */
.radio-group {
  display: flex;
  gap: 40rpx;
  margin-top: 15rpx;
}

.radio-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 32rpx;
  color: #333;
}

/* 操作按钮区域 */
.action-section {
  display: flex;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

/* 按钮样式 */
.submit-btn {
  flex: 1;
  background-color: royalblue;
  color: white;
  border: none;
  border-radius: 15rpx;
  padding: 25rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.cancel-btn {
  flex: 1;
  background-color: white;
  color: #333;
  border: 4rpx solid rgba(105, 105, 105, 0.397);
  border-radius: 15rpx;
  padding: 25rpx;
  font-size: 32rpx;
  font-weight: 600;
}

/* 搜索结果区域 */
.result-section {
  background-color: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.result-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

/* 用户卡片 */
.user-card {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border: 4rpx solid rgba(105, 105, 105, 0.397);
  border-radius: 15rpx;
  margin-bottom: 20rpx;
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 5rpx;
}

.user-id {
  font-size: 28rpx;
  color: rgba(88, 87, 87, 0.822);
  display: block;
  margin-bottom: 5rpx;
}

.user-type {
  font-size: 28rpx;
  color: royalblue;
  display: block;
}

/* 确认按钮 */
.confirm-btn {
  width: 100%;
  background-color: #52c41a;
  color: white;
  border: none;
  border-radius: 15rpx;
  padding: 25rpx;
  font-size: 32rpx;
  font-weight: 600;
}

/* 按钮按下效果 */
.submit-btn:active {
  background-color: rgb(56, 90, 194);
}

.cancel-btn:active {
  background-color: #f5f5f5;
}

.confirm-btn:active {
  background-color: #389e0d;
}
