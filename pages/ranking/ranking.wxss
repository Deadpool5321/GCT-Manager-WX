/* pages/ranking/ranking.wxss */
/* 全局样式 */
page {
  margin: 0;
  padding: 0;
  font-family: 'Segoe UI', sans-serif;
  background-color: #f0f2f5;
  min-height: 100vh !important;
}

/* 主容器 */
.ranking-container {
  padding: 40rpx;
  box-sizing: border-box;
}

/* 页面标题 */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  color: #333;
}

.period {
  font-size: 28rpx;
  color: rgba(88, 87, 87, 0.822);
}

/* 前三名容器 */
.top3-container {
  display: flex;
  justify-content: space-around;
  align-items: flex-end;
  margin-bottom: 50rpx;
  background-color: white;
  border-radius: 20rpx;
  padding: 40rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

/* 前三名通用样式 */
.top-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 200rpx;
}

/* 奖杯图标 */
.trophy-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 10rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.trophy-icon image {
  width: 100%;
  height: 100%;
}

/* 排名徽章 */
.rank-badge {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 20rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

/* 排名数字 */
.rank-number {
  font-size: 32rpx;
  font-weight: 700;
  color: white;
  z-index: 1;
  position: absolute;
  top: 15rpx;
  right: 15rpx;
  background-color: rgba(0, 0, 0, 0.3);
  padding: 5rpx 10rpx;
  border-radius: 20rpx;
}

/* 前三名头像 */
.rank-badge image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  z-index: 2;
  border: 4rpx solid white;
}

/* 第一名样式 */
.r1 {
  margin-bottom: 40rpx;
  transform: scale(1.1);
}

.r1 .rank-badge {
  background: linear-gradient(135deg, #ffd700, #ffed4e);
  border: 8rpx solid #ffd700;
  box-shadow: 0 0 25rpx rgba(255, 215, 0, 0.6);
}

.r1 .trophy-icon image {
  filter: brightness(0) saturate(100%) invert(87%) sepia(63%) saturate(3750%) hue-rotate(350deg) brightness(104%) contrast(104%);
}

/* 第二名样式 */
.r2 .rank-badge {
  background: linear-gradient(135deg, #c0c0c0, #e0e0e0);
  border: 6rpx solid #c0c0c0;
  box-shadow: 0 0 15rpx rgba(192, 192, 192, 0.5);
}

.r2 .trophy-icon image {
  filter: brightness(0) saturate(100%) invert(70%) sepia(0%) saturate(100%) hue-rotate(0deg) brightness(100%) contrast(100%);
}

/* 第三名样式 */
.r3 .rank-badge {
  background: linear-gradient(135deg, #cd7f32, #e6a267);
  border: 6rpx solid #cd7f32;
  box-shadow: 0 0 15rpx rgba(205, 127, 50, 0.5);
}

.r3 .trophy-icon image {
  filter: brightness(0) saturate(100%) invert(70%) sepia(20%) saturate(700%) hue-rotate(350deg) brightness(90%) contrast(90%);
}

/* 用户名 */
.user-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 10rpx;
}

/* 用户组别 */
.user-group {
  font-size: 24rpx;
  color: rgba(88, 87, 87, 0.822);
  margin-bottom: 10rpx;
}

/* 用户次数 */
.user-count {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

/* 排名列表 */
.ranking-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 排名项 */
.ranking-item {
  display: flex;
  align-items: center;
  background-color: white;
  border: 4rpx solid rgba(105, 105, 105, 0.397);
  border-radius: 15rpx;
  padding: 30rpx;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.1);
}

/* 排名数字 */
.ranking-item .rank-number {
  font-size: 32rpx;
  font-weight: 600;
  color: rgba(88, 87, 87, 0.822);
  width: 60rpx;
  text-align: center;
  position: static;
}

/* 排名项头像 */
.ranking-item image {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

/* 用户信息 */
.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

/* 排名项用户名 */
.ranking-item .user-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 5rpx;
}

/* 排名项用户组别 */
.ranking-item .user-group {
  font-size: 24rpx;
  color: rgba(88, 87, 87, 0.822);
  margin-bottom: 0;
}

/* 排名项用户次数 */
.ranking-item .user-count {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-right: 30rpx;
  width: 120rpx;
  text-align: right;
}

/* 参与率 */
.participation-rate {
  font-size: 24rpx;
  color: rgba(88, 87, 87, 0.822);
  text-align: right;
}

/* 本人排名高亮 */
.my-ranking {
  background-color: rgba(65, 105, 225, 0.1);
  border-color: royalblue;
}

/* 本人排名数字 */
.my-ranking .rank-number {
  color: royalblue;
}

/* 本人排名用户名 */
.my-ranking .user-name {
  color: royalblue;
}

/* 下降趋势 */
.trend-down {
  color: #ff6b9d;
}

/* 持平趋势 */
.trend-equal {
  color: rgba(88, 87, 87, 0.822);
}