/* pages/admin-publish/publish.wxss */
/* 全局样式 */
page {
  margin: 0;
  padding: 0;
  font-family: 'Segoe UI', sans-serif;
  background-color: #f0f2f5;
  min-height: 100vh !important;
}

/* 主容器 */
.publish-container {
  padding: 40rpx;
  box-sizing: border-box;
}

/* 页面标题 */
.page-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 40rpx;
  padding-bottom: 20rpx;
  border-bottom: 4rpx solid royalblue;
}

/* 表单区域 */
.form-section {
  background-color: white;
  border: 4rpx solid rgba(105, 105, 105, 0.397);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

/* 表单区域标题 */
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 30rpx;
  display: block;
}

/* 表单行 */
.form-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

/* 半宽表单项 */
.half-width {
  width: 48%;
}

/* 表单项 */
.form-item {
  margin-bottom: 30rpx;
  position: relative;
}

/* 表单标签 */
.label {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 15rpx;
  display: block;
}

/* 输入框 */
.input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid rgba(105, 105, 105, 0.3);
  border-radius: 15rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  background-color: white;
  display: flex;
  align-items: center;
}

/* 输入框占位符 */
.input-placeholder {
  position: absolute;
  left: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 30rpx;
  color: #999;
  pointer-events: none;
  transition: all 0.3s ease;
}

/* 选择器 */
.picker {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid rgba(105, 105, 105, 0.3);
  border-radius: 15rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  background-color: white;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #333;
}

/* 选择器输入框 */
.picker-input {
  flex: 1;
}

/* 单选按钮行 */
.radio-row {
  display: flex;
  justify-content: space-around;
  margin-bottom: 20rpx;
}

/* 单选按钮项 */
.radio-item {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  border-radius: 15rpx;
  background-color: rgba(65, 105, 225, 0.05);
  transition: all 0.3s ease;
}

/* 单选按钮选中状态 */
.radio-item radio:checked + .radio-text {
  color: royalblue;
}

/* 单选按钮文本 */
.radio-text {
  font-size: 28rpx;
  color: #333;
  margin-left: 10rpx;
}

/* 通知设置项 */
.notice-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 25rpx;
}

/* 通知文本 */
.notice-text {
  font-size: 28rpx;
  color: #333;
}

/* 提交按钮 */
.submit-btn {
  background-color: royalblue;
  color: white;
  border: none;
  border-radius: 20rpx;
  padding: 30rpx;
  font-size: 34rpx;
  font-weight: 600;
  width: 100%;
  margin-top: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(65, 105, 225, 0.3);
}

/* 提交按钮按下效果 */
.submit-btn:active {
  background-color: rgb(53, 90, 201);
}