/* pages/student/student.wxss */
/* 全局样式 */
page {
  margin: 0;
  padding: 0;
  font-family: 'Segoe UI', sans-serif;
  background-color: #f0f2f5;
  min-height: 100vh !important;
}

/* 主容器 */
.student-container {
  padding: 40rpx;
  box-sizing: border-box;
}

/* 任务区块 */
.task-section {
  margin-bottom: 50rpx;
  background-color: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

/* 区块标题 */
.section-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 30rpx;
  display: block;
}

/* 任务卡片 */
.task-card {
  border: 4rpx solid rgba(105, 105, 105, 0.397);
  border-radius: 15rpx;
  padding: 30rpx;
  background-color: #fff;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.1);
}

/* 任务名称 */
.task-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

/* 任务时间和地点 */
.task-time, .task-location {
  font-size: 28rpx;
  color: rgba(88, 87, 87, 0.822);
  margin-bottom: 15rpx;
}

/* 任务操作按钮 */
.task-operation {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

/* 接受按钮 */
.accept-btn {
  flex: 1;
  background-color: royalblue;
  color: white;
  border: none;
  border-radius: 15rpx;
  padding: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
}

/* 拒绝按钮 */
.reject-btn {
  flex: 1;
  background-color: #ff6b9d;
  color: white;
  border: none;
  border-radius: 15rpx;
  padding: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
}

/* 无任务提示 */
.no-task {
  text-align: center;
  color: rgba(88, 87, 87, 0.822);
  font-size: 28rpx;
  padding: 50rpx 0;
}

/* 任务列表 */
.task-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 到期任务卡片 */
.expire-task {
  border: 4rpx solid rgba(105, 105, 105, 0.397);
  border-radius: 15rpx;
  padding: 25rpx;
  background-color: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.1);
}

/* 到期任务时间 */
.expire-task .task-time {
  margin-bottom: 0;
  color: #ff6b9d;
  font-weight: 500;
}

/* 按钮按下效果 */
.accept-btn:active {
  background-color: rgb(56, 90, 194);
}

.reject-btn:active {
  background-color: rgb(230, 85, 135);
}