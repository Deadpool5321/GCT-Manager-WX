<view class="settings-container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="header-title">设置</text>
  </view>

  <!-- 个人信息设置 -->
  <view class="settings-section">
    <text class="section-title">个人信息</text>
    
    <!-- 头像设置 -->
    <view class="setting-item" bindtap="changeAvatar">
      <text class="setting-label">头像</text>
      <view class="setting-value">
        <image src="{{userInfo.avatar || '/images/avatar-default.svg'}}" class="avatar-preview"></image>
        <text class="setting-arrow">></text>
      </view>
    </view>
    
    <!-- 名称设置 -->
    <view class="setting-item" bindtap="changeName">
      <text class="setting-label">名称</text>
      <view class="setting-value">
        <text class="value-text">{{userInfo.name || '未设置'}}</text>
        <text class="setting-arrow">></text>
      </view>
    </view>
  </view>

  <!-- 其他设置 -->
  <view class="settings-section">
    <text class="section-title">其他</text>
    
    <!-- 清除缓存 -->
    <view class="setting-item" bindtap="clearCache">
      <text class="setting-label">清除缓存</text>
      <view class="setting-value">
        <text class="value-text">{{cacheSize || '0KB'}}</text>
        <text class="setting-arrow">></text>
      </view>
    </view>
    

  </view>
</view>