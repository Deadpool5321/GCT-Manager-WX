/* pages/settings/settings.wxss */

/* 全局样式 */
page {
  margin: 0;
  padding: 0;
  font-family: 'Segoe UI', sans-serif;
  background-color: #f0f2f5;
  min-height: 100vh !important;
}

/* 主容器 */
.settings-container {
  padding: 40rpx;
  box-sizing: border-box;
}

/* 页面标题 */
.page-header {
  margin-bottom: 40rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

/* 设置区块 */
.settings-section {
  background-color: white;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  overflow: hidden;
}

/* 区块标题 */
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(88, 87, 87, 0.822);
  padding: 30rpx 30rpx 10rpx 30rpx;
  display: block;
}

/* 设置项 */
.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 4rpx solid rgba(221, 221, 221, 0.3);
}

.setting-item:last-child {
  border-bottom: none;
}

/* 设置标签 */
.setting-label {
  font-size: 32rpx;
  color: #333;
}

/* 设置值 */
.setting-value {
  display: flex;
  align-items: center;
}

/* 文本值 */
.value-text {
  font-size: 32rpx;
  color: rgba(88, 87, 87, 0.822);
  margin-right: 10rpx;
}

/* 头像预览 */
.avatar-preview {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

/* 箭头 */
.setting-arrow {
  font-size: 32rpx;
  color: rgba(88, 87, 87, 0.822);
}

/* 设置项点击效果 */
.setting-item:active {
  background-color: #f5f5f5;
}
