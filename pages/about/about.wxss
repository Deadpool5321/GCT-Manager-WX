/* pages/about/about.wxss */

/* 全局样式 */
page {
  margin: 0;
  padding: 0;
  font-family: 'Segoe UI', sans-serif;
  background-color: #f0f2f5;
  min-height: 100vh !important;
}

/* 主容器 */
.about-container {
  padding: 40rpx;
  box-sizing: border-box;
}

/* 页面标题 */
.page-header {
  margin-bottom: 40rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

/* 内容区域 */
.content-section {
  background-color: white;
  border-radius: 20rpx;
  padding: 60rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  text-align: center;
}

/* Logo区域 */
.logo-section {
  margin-bottom: 60rpx;
}

.logo {
  width: 200rpx;
  height: 200rpx;
  border-radius: 40rpx;
  margin-bottom: 30rpx;
}

.app-name {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.app-version {
  font-size: 28rpx;
  color: rgba(88, 87, 87, 0.822);
  display: block;
}

/* 占位文本区域 */
.placeholder-section {
  margin-bottom: 60rpx;
  padding: 60rpx;
  background-color: #f5f5f5;
  border-radius: 20rpx;
}

.placeholder-text {
  font-size: 40rpx;
  font-weight: 600;
  color: royalblue;
  display: block;
}

/* 信息区域 */
.info-section {
  padding-top: 30rpx;
  border-top: 4rpx solid rgba(221, 221, 221, 0.3);
}

.info-text {
  font-size: 28rpx;
  color: rgba(88, 87, 87, 0.822);
  display: block;
  margin-bottom: 10rpx;
}
